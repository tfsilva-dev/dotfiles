-- This config is a STUB! This should never be generated.
-- Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua

-- Darkmode
-- Generated by hyprlang2lua. Review TODOs before reloading Hyprland.

hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")

-- Variável obrigatória para o Zen/Firefox rodar liso no Wayland
hl.env("MOZ_ENABLE_WAYLAND", "1")

local mainMod = "SUPER"
local terminal = "kitty"
local fileManager = "nemo"
local menu = "wofi --show drun"
-- Navegador padrão alterado para o Zen
local browser = "zen-browser"

hl.bind(mainMod .. " + Q", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + C", hl.dsp.window.close())
hl.bind(mainMod .. " + M", hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit"))
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + B", hl.dsp.exec_cmd(browser))

-- AutoStart

-- printTela (Corrigido o espaço na formatação do comando date)
hl.bind("Print", hl.dsp.exec_cmd("grim - | wl-copy"))
hl.bind("SUPER + SHIFT + S", hl.dsp.exec_cmd("grim -g \"$(slurp -d)\" - | wl-copy"))
hl.bind("SUPER + SHIFT + P", hl.dsp.exec_cmd("grim -g \"$(slurp -d)\" ~/Imagens/print_$(date +'%Y%m%d_%H%M%S').png"))

-- Tide Island workspace overview
hl.bind("SUPER + TAB", hl.dsp.exec_cmd("qs ipc -p /usr/share/tide-island call overview toggle"))

hl.on("hyprland.start", function()
    hl.exec_cmd("waybar")
end)

hl.on("config.reloaded", function()
    hl.exec_cmd("gsettings set org.gnome.desktop.interface gtk-theme \"adw-gtk3-dark\"")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface color-scheme \"prefer-dark\"")
end)

