# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua

# Darkmode
exec = gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-dark"
exec = gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
env = QT_QPA_PLATFORMTHEME,qt6ct

# Variável obrigatória para o Zen/Firefox rodar liso no Wayland
env = MOZ_ENABLE_WAYLAND,1

$mainMod = SUPER
$terminal = kitty
$fileManager = nemo
$menu = wofi --show drun
# Navegador padrão alterado para o Zen
$browser = zen-browser

bind = $mainMod, Q, exec, $terminal
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu
bind = $mainMod, B, exec, $browser

# AutoStart
exec-once = waybar


# printTela (Corrigido o espaço na formatação do comando date)
bind = , Print, exec, grim - | wl-copy
bind = SUPER SHIFT, S, exec, grim -g "$(slurp -d)" - | wl-copy
bind = SUPER SHIFT, P, exec, grim -g "$(slurp -d)" ~/Imagens/print_$(date +'%Y%m%d_%H%M%S').png

# Tide Island workspace overview
bind = SUPER, TAB, exec, qs ipc -p /usr/share/tide-island call overview toggle
